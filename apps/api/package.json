{
  "name": "@curio/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.d.ts"
  },
  "scripts": {
    "dev": "dotenvx run -- tsx watch src/index.ts",
    "build": "tsc",
    "prebuild": "pnpm clean",
    "start": "dotenvx run -- node dist/index.js",
    "start:prod": "dotenvx run -- node dist/index.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src/__tests__/unit",
    "test:integration": "vitest run src/__tests__/integration",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@curio/database": "workspace:*",
    "@hono/node-server": "^1.14.1",
    "@hono/swagger-ui": "^0.5.3",
    "@hono/zod-openapi": "^1.2.0",
    "better-auth": "^1.2.8",
    "hono": "^4.11.4",
    "neverthrow": "^8.2.0",
    "pino": "^10.2.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.51.4",
    "@prisma/adapter-pg": "^7.2.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.16.0",
    "@vitest/coverage-v8": "^4.0.17",
    "pg": "^8.16.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
