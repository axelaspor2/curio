{
  "name": "curio-apps",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "db:generate": "pnpm --filter @curio/database db:generate",
    "db:migrate": "pnpm --filter @curio/database db:migrate:dev",
    "db:studio": "pnpm --filter @curio/database db:studio",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.0"
}
