{
  "name": "@curio/jobs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "rss-fetch": "dotenvx run -- tsx src/rss-fetch/index.ts",
    "build": "tsc",
    "prebuild": "pnpm clean",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "dotenvx run -- vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@curio/database": "workspace:*",
    "neverthrow": "^8.2.0",
    "pino": "^10.2.0",
    "pino-pretty": "^13.1.3",
    "rss-parser": "^3.13.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.51.4",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.0.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
