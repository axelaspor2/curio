{
  "name": "@curio/jobs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "rss-fetch": "dotenvx run -- tsx src/rss-fetch/index.ts",
    "article-fetch": "dotenvx run -- tsx src/article-fetch/index.ts",
    "article-enrichment": "dotenvx run -- tsx src/article-enrichment/index.ts",
    "interest-vector": "dotenvx run -- tsx src/interest-vector/index.ts",
    "reset-all": "dotenvx run -- tsx src/reset-all.ts",
    "seed-data": "dotenvx run -- tsx src/seed-data.ts",
    "check-db": "dotenvx run -- tsx src/check-users.ts",
    "build": "tsc",
    "prebuild": "pnpm clean",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "dotenvx run -- vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "biome check src",
    "format": "biome format --write src"
  },
  "dependencies": {
    "@curio/database": "workspace:*",
    "@google/genai": "^1.39.0",
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^28.0.0",
    "neverthrow": "^8.2.0",
    "pino": "^10.2.0",
    "pino-pretty": "^13.1.3",
    "rss-parser": "^3.13.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@dotenvx/dotenvx": "^1.51.4",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.0.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
